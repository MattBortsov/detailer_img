# Copy to .env on the server. Never commit the filled file.

# Compose/PostgreSQL
POSTGRES_DB=car_wrap
POSTGRES_USER=car_wrap
POSTGRES_PASSWORD=
DATABASE_URL=
APP_BIND_PORT=8010
APP_IMAGE_TAG=local

# Telegram and public HTTPS endpoint
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
MINI_APP_URL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=x-ai/grok-imagine-image-quality
MODERATION_VISION_MODEL=google/gemini-2.5-flash

# Custom color references
ADMIN_TELEGRAM_USER_IDS=
CUSTOM_COLOR_MAX_BYTES=8388608
CUSTOM_COLOR_MAX_SIDE_PX=8192
CUSTOM_COLOR_MAX_PIXELS=20000000
CUSTOM_COLOR_OUTPUT_LONG_EDGE_PX=2048
CUSTOM_COLOR_DECODE_TIMEOUT_SECONDS=15
CUSTOM_COLOR_QUOTA=20
